# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Catalyst Project
CATALYST_PROJECT_ID=your_project_id
CATALYST_ACCOUNT_ID=your_account_id

# Catalyst Data Store (Database)
CATALYST_DB_HOST=your_db_host
CATALYST_DB_PORT=3306
CATALYST_DB_NAME=DRISHTI
CATALYST_DB_USER=your_db_user
CATALYST_DB_PASSWORD=your_db_password

# Catalyst Zia Services
CATALYST_ZIA_API_KEY=your_zia_api_key

# Catalyst QuickML
CATALYST_QUICKML_ENDPOINT=your_quickml_endpoint

# askDrishtiAI function env vars
# QuickML RAG endpoint (GLM-4.7-Flash knowledge base)
QUICKML_RAG_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/YOUR_PROJECT_ID/glm/chat
# Zia text translation endpoint
QUICKML_TRANSLATE_ENDPOINT_URL=https://zia.catalyst.zoho.in/api/v1/text/translate
# Zia STT (Audio-to-Text) endpoint
QUICKML_STT_ENDPOINT_URL=https://zia.catalyst.zoho.in/api/v1/audio/transcription
# Zia TTS (Text-to-Audio) endpoint
QUICKML_TTS_ENDPOINT_URL=https://zia.catalyst.zoho.in/api/v1/audio/synthesis
# Zoho OAuth token (Zoho-oauthtoken <token>)
QUICKML_OAUTH_TOKEN=your_zoho_oauth_token_here
# Catalyst organisation ID
CATALYST_ORG_ID=your_catalyst_org_id_here


# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api